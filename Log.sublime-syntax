%YAML 1.2
---
name: Build output
version: 1

scope: source.log_output

file_extensions:
  - log

contexts:
  # The prototype context is prepended to all contexts but those setting
  # meta_include_prototype: false.
  # prototype:

  main:

  # BuildSys make output
    - match: "(\\d+:\\d+:\\d+) (INFO)\\s+\\| Make (\\S+) \\| Tools: (\\S+)"
      captures:
        1: message.note
        2: message.note.bold
        3: log_output.rule
        4: log_output.detail


    - match: "(\\d+:\\d+:\\d+) (INFO)\\s+\\| Make (\\S+)"
      captures:
        1: message.note
        2: message.note.bold
        3: log_output.rule


    - match: "^(INFO)\\s+\\| See (\\S+, line 1)\\s(.*)"
      captures:
        1: message.note.bold
        2: log_output.file

    - match: "^(INFO)\\s+\\| (.*)"
      captures:
        1: message.note.bold
        2: message.note

    - match: "^(ERROR)\\s+\\| (.*)"
      captures:
        1: message.error.bold
        2: message.error

  #Python log output
    - match: "(\\d+:\\d+:\\d+) (INFO)\\s+(\\| .* \\|) (.*)"
      captures:
        1: message.note
        2: message.note.bold
        3: message.note
        4: message.note.underline

    - match: "(\\d+:\\d+:\\d+) (ERROR)\\s+(\\| .* \\|) (.*)"
      captures:
        1: message.error
        2: message.error.bold
        3: message.error
        4: message.error.underline

    - match: "(\\d+:\\d+:\\d+) (WARNING)\\s+(\\| .* \\|) (.*)"
      captures:
        1: message.warning
        2: message.warning.bold
        3: message.warning
        4: message.warning.underline

  # Sublime build output
    - match: "^\\[(shell_cmd|dir|path|Finished).*\\]"
      captures:
        1: log_output.bold

  # make output
    - match: "^(Building) (file|target): (.*)"
      captures:
        1: log_output.bold
        3: log_output.bold

    - match: "^(Invoking)(.*)"
      captures:
        1: log_output.bold

    - match: "^(Finished)(.*):(.*)"
      captures:
        1: log_output.bold
        3: log_output.bold

  # linker output
    - match: "^.*(error: ld).*$"
      scope: message.error

    - match: "^.*(: failed).*$"
      scope: message.error

    - match: "^.*(: multiple definition).*$"
      scope: message.error

    - match: "^.*(: undefined reference).*$"
      scope: message.error

  # gcc output
    - match: "^(.*):([0-9]+):([0-9]*):* (error): (.*)$"
      scope: message.error
      captures:
        4: message.error.detail

    - match: "^(.*):([0-9]+):([0-9]*):* (fatal error): (.*)$"
      scope: message.error.fatal
      captures:

    - match: "^(.*):([0-9]+):([0-9]*):* (warning): (.*)$"
      scope: message.warning
      captures:
        4: message.warning.detail

    - match: "^(.*):([0-9]+):([0-9]*):* (note): (.*)$"
      scope: message.note
      captures:
        4: message.note.detail

  # Cadence Xcelium output
    - match: "file:\\s(.*)"
      captures:
        1: log_output.bold

    - match: "module\\s\\w+\\s\\(.*"
      scope: log_output.bold

    - match: "(?:xrun|xmvlog|xmvlog_cg|xmelab|halcheck|halstruct|halsynth|xmsim): \\*[E],[A-Z0-9]+ \\((.*),(\\d+)\\|*(\\d*)\\): (.*)"
      scope: message.error
      captures:
        1: message.error.detail
        4: message.error.detail

    - match: "(?:xrun|xmvlog|xmvlog_cg|xmelab|halcheck|halstruct|halsynth|xmsim): \\*[W],[A-Z0-9]+ \\((.*),(\\d+)\\|*(\\d*)\\): (.*)"
      scope: message.warning
      captures:
        1: message.warning.detail
        4: message.warning.detail

    - match: "(?:xrun|xmvlog|xmvlog_cg|xmelab|halcheck|halstruct|halsynth|xmsim): \\*[N],[A-Z0-9]+ \\((.*),(\\d+)\\|*(\\d*)\\): (.*)"
      scope: message.note
      captures:
        1: message.note.location
        2: message.note.location
        3: message.note.location

    - match: "(?:xrun|xmvlog|xmvlog_cg|xmelab|halcheck|halsynth|xmsim): \\*[F],[A-Z0-9]+ \\((.*),(\\d+)\\|*(\\d*)\\): (.*)"
      scope: message.error.fatal

  # Cadence Xcelium output wo file/line/pos
    - match: "(?:xrun|xmvlog|xmvlog_cg|xmelab|halcheck|halsynth|xmsim): \\*[E],[A-Z0-9]+:\\s.*"
      scope: message.error

    - match: "(?:xrun|xmvlog|xmvlog_cg|xmelab|halcheck|halsynth|xmsim): \\*[W],[A-Z0-9]+:\\s.*"
      scope: message.warning

  # Cadence Xcelium UVM output
    - match: "file:\\s(.*)"
      captures:
        1: log_output.bold

    - match: "module\\s\\w+\\s\\(.*"
      scope: log_output.bold

    - match: "(?:UVM_ERROR)\\s+(.*)\\((\\d+)\\)\\s+@ (\\d+\\.\\d+ns) (.*)"
      scope: message.error
      captures:
        1: message.error.detail
        2: message.error.detail
        3: message.error.detail

    - match: "(UVM_ERROR) :\\s+\\d+"
      scope: message.error

    - match: "(?:UVM_WARNING)\\s+(.*)\\((\\d+)\\)\\s+@ (\\d+\\.\\d+ns) (.*)"
      scope: message.warning
      captures:
        1: message.warning.detail
        2: message.warning.detail
        3: message.warning.detail

    - match: "(?:UVM_WARNING) @ (\\d+\\.\\d+ns): (.*)"
      scope: message.warning
      captures:
        1: message.warning.detail

    - match: "(UVM_WARNING) :\\s+\\d+"
      scope: message.warning

    - match: "(UVM_INFO)\\s+(.*)\\((\\d+)\\)\\s+@ (\\d+\\.\\d+ns)\\s+(.*)"
      scope: message.note
      captures:
        2: message.note.location
        3: message.note.location

    - match: "(UVM_INFO) @ (\\d+ps): (.*)"
      scope: message.note
      captures:
        2: message.note.location

    - match: "(UVM_INFO) :\\s+\\d+"
      scope: message.note

    - match: "(UVM_FATAL).+"
      scope: message.error.fatal

    # Xilinx Vivado binary tools output
    - match: "(ERROR:) File: (/.*) Line: \\d+.*"
      scope: message.error
      captures:
        1: message.error.bold
        2: message.error.underline

    # Xilinx Vivado binary tools output
    - match: "(ERROR:) (\\[.*\\]) (.*) (\\[.*\\])"
      scope: message.error
      captures:
        1: message.error.bold
        4: message.error.underline

    # Xilinx Vivado binary tools output
    - match: "(ERROR:) (\\[.*\\]) (.*)"
      scope: message.error
      captures:
        1: message.error.bold

    # UVM framework output
    - match: "^(UVM_ERROR) (\\[[A-Z/]*\\]) @ +(\\d+\\.\\d+ns) (.*) (/.*)$"
      scope: message.error
      captures:
        1: message.error.bold
        3: message.error.bold
        5: message.error.underline

    # UVM framework output
    - match: "(UVM_FATAL|UVM_ERROR)(.*)"
      scope: message.error
      captures:
        1: message.error.bold





    # Xilinx Vivado binary tools output
    - match: "(WARNING:) (\\[.*\\]) (File : /.*, Line : \\d+,) (.*)"
      scope: message.warning
      captures:
        1: message.warning.bold
        3: message.warning.underline

    # Xilinx Vivado binary tools output
    - match: "(WARNING:) (\\[.*\\]) (\"/.*\" Line \\d+.) (.*)"
      scope: message.warning
      captures:
        1: message.warning.bold
        3: message.warning.underline

    # Xilinx Vivado binary tools output
    - match: "(WARNING:) (\\[.*\\]) (.*) (\\[/.*:\\d+\\])(.*)"
      scope: message.warning
      captures:
        1: message.warning.bold
        4: message.warning.underline


    # Xilinx Vivado binary tools output
    - match: "(WARNING:) (\\[.*\\]) (.*)"
      scope: message.warning
      captures:
        1: message.warning.bold

    # UVM framework output
    - match: "^(UVM_WARNING) (\\[.*\\]) @ +(\\d+\\.\\d+ns) (.*) (/.*)$"
      scope: message.warning
      captures:
        1: message.warning.bold
        3: message.warning.bold
        5: message.warning.underline

    # UVM framework output
    - match: "(UVM_WARNING) (\\[.*\\]) (.*)"
      scope: message.warning
      captures:
        1: message.warning.bold

    # UVM framework output
    - match: "(UVM_WARNING) (.*)"
      scope: message.warning
      captures:
        1: message.warning.bold






    # Xilinx Vivado binary tools output
    - match: "(INFO:) (\\[.*\\]) .* (\"/.*\") .*"
      scope: message.note
      captures:
        1: message.note.bold
        3: message.note.underline

    # Xilinx Vivado binary tools output
    - match: "(INFO:) (\\[.*\\]) .*"
      scope: message.note
      captures:
        1: message.note.bold

    # Xilinx Vivado binary tools output
    - match: "(\\[INFO\\]).*"
      scope: message.note
      captures:
        1: message.note.bold

    # UVM framework output
    - match: "^(UVM_INFO) (\\[.*\\]) @ +(\\d+\\.\\d+ns) (.*) (/.*)$"
      scope: message.note
      captures:
        1: message.note.bold
        3: message.note.bold
        5: message.note.underline

    # UVM framework output
    - match: "(UVM_INFO) (\\[.*\\]) (.*)"
      scope: message.note
      captures:
        1: message.note.bold

    # UVM framework output
    - match: "(UVM_INFO) (.*)"
      scope: message.note
      captures:
        1: message.note.bold

  #Python output
    - match: "File\\s\"(.*)\",\\sline\\s\\d+,\\sin\\s(.*)"
      captures:
        1: message.error
        2: message.error.detail

    - match: "File\\s\"(.*)\",\\sline\\s\\d+"
      captures:
        1: message.error

    - match: "(.*):(\\d+):\\s(RuntimeWarning|DeprecationWarning):\\s(.*)"
      captures:
        1: message.warning.detail
        2: message.warning.detail
        3: message.warning
        4: message.warning.detail

  #Python/CocoTB output
    - match: ".*\\sINFO\\s.*Status=Error.*"
      scope: message.error

    - match: ".*\\sINFO\\s.*(Status=Ok).*"
      scope: message.note
      captures:
        1: message.note.detail

    - match: ".*\\sDEBUG\\s.*"
      scope: log_output

    - match: ".*\\sINFO\\s.*"
      scope: message.note

    - match: ".*\\sWARNING\\s.*"
      scope: message.warning

    - match: ".*\\sERROR\\s.*"
      scope: message.error

    - match: ".*\\s(CRITICAL)\\s.*"
      scope: message.error
      captures:
        1: message.error.detail
